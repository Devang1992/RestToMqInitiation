CREATE / ALTER VIEW
CREATE OR ALTER VIEW dbo.vwCdcAdvices
WITH SCHEMABINDING
AS
SELECT
    /* =========================================================
       PRIMARY KEY (REQUIRED FOR UNIQUE CLUSTERED INDEX)
       ========================================================= */
    mif.PK_MIF,

    /* =========================================================
       CDC TIMESTAMP (DATE + TIME → DATETIME2)
       ========================================================= */
    DATEADD
    (
        SECOND,
        DATEDIFF
        (
            SECOND,
            CONVERT(TIME, '00:00:00', 108),
            CONVERT(TIME, mif.TIME, 108)
        ),
        CONVERT(DATETIME2, mif.DATE, 112)
    ) AS UPDATE_TIMESTAMP,

    /* =========================================================
       BUSINESS KEYS
       ========================================================= */
    mif.MID,
    mif.Version,

    /* =========================================================
       STATUS & ELIGIBILITY (NO HARD FILTER)
       ========================================================= */
    mif.MST_STATUS,

    CASE
        WHEN mif.MST_STATUS IN ('COMPLETE', 'AGED')
            THEN 1
        ELSE 0
    END AS IS_ELIGIBLE,

    /* =========================================================
       ===================== MIF FIELDS (20) ====================
       ========================================================= */
    mif.UETR                    AS MIF_UETR,
    mif.DATE                    AS MIF_DATE,
    mif.TIME                    AS MIF_TIME,
    mif.FIELD1                  AS MIF_FIELD1,
    mif.FIELD2                  AS MIF_FIELD2,
    mif.FIELD3                  AS MIF_FIELD3,
    mif.FIELD4                  AS MIF_FIELD4,
    mif.FIELD5                  AS MIF_FIELD5,
    mif.FIELD6                  AS MIF_FIELD6,
    mif.FIELD7                  AS MIF_FIELD7,
    mif.FIELD8                  AS MIF_FIELD8,
    mif.FIELD9                  AS MIF_FIELD9,
    mif.FIELD10                 AS MIF_FIELD10,
    mif.FIELD11                 AS MIF_FIELD11,
    mif.FIELD12                 AS MIF_FIELD12,
    mif.FIELD13                 AS MIF_FIELD13,
    mif.FIELD14                 AS MIF_FIELD14,
    mif.FIELD15                 AS MIF_FIELD15,
    mif.FIELD16                 AS MIF_FIELD16,
    mif.FIELD17                 AS MIF_FIELD17,
    mif.FIELD18                 AS MIF_FIELD18,
    mif.FIELD19                 AS MIF_FIELD19,
    mif.FIELD20                 AS MIF_FIELD20,

    /* =========================================================
       ================== MTFISOXML FIELDS (20) =================
       ========================================================= */
    mtfiso.MTFISOXML_XMLDATA    AS ISO_XML,
    mtfiso.FIELD1              AS ISO_FIELD1,
    mtfiso.FIELD2              AS ISO_FIELD2,
    mtfiso.FIELD3              AS ISO_FIELD3,
    mtfiso.FIELD4              AS ISO_FIELD4,
    mtfiso.FIELD5              AS ISO_FIELD5,
    mtfiso.FIELD6              AS ISO_FIELD6,
    mtfiso.FIELD7              AS ISO_FIELD7,
    mtfiso.FIELD8              AS ISO_FIELD8,
    mtfiso.FIELD9              AS ISO_FIELD9,
    mtfiso.FIELD10             AS ISO_FIELD10,
    mtfiso.FIELD11             AS ISO_FIELD11,
    mtfiso.FIELD12             AS ISO_FIELD12,
    mtfiso.FIELD13             AS ISO_FIELD13,
    mtfiso.FIELD14             AS ISO_FIELD14,
    mtfiso.FIELD15             AS ISO_FIELD15,
    mtfiso.FIELD16             AS ISO_FIELD16,
    mtfiso.FIELD17             AS ISO_FIELD17,
    mtfiso.FIELD18             AS ISO_FIELD18,
    mtfiso.FIELD19             AS ISO_FIELD19,
    mtfiso.FIELD20             AS ISO_FIELD20,

    /* =========================================================
       ===================== MTF1000 FIELDS (20) =================
       ========================================================= */
    mtf.FIELD1                 AS MTF_FIELD1,
    mtf.FIELD2                 AS MTF_FIELD2,
    mtf.FIELD3                 AS MTF_FIELD3,
    mtf.FIELD4                 AS MTF_FIELD4,
    mtf.FIELD5                 AS MTF_FIELD5,
    mtf.FIELD6                 AS MTF_FIELD6,
    mtf.FIELD7                 AS MTF_FIELD7,
    mtf.FIELD8                 AS MTF_FIELD8,
    mtf.FIELD9                 AS MTF_FIELD9,
    mtf.FIELD10                AS MTF_FIELD10,
    mtf.FIELD11                AS MTF_FIELD11,
    mtf.FIELD12                AS MTF_FIELD12,
    mtf.FIELD13                AS MTF_FIELD13,
    mtf.FIELD14                AS MTF_FIELD14,
    mtf.FIELD15                AS MTF_FIELD15,
    mtf.FIELD16                AS MTF_FIELD16,
    mtf.FIELD17                AS MTF_FIELD17,
    mtf.FIELD18                AS MTF_FIELD18,
    mtf.FIELD19                AS MTF_FIELD19,
    mtf.FIELD20                AS MTF_FIELD20,

    /* =========================================================
       ================== MTFREMINFO FIELDS (20) =================
       ========================================================= */
    rinfo.FIELD1               AS REMINFO_FIELD1,
    rinfo.FIELD2               AS REMINFO_FIELD2,
    rinfo.FIELD3               AS REMINFO_FIELD3,
    rinfo.FIELD4               AS REMINFO_FIELD4,
    rinfo.FIELD5               AS REMINFO_FIELD5,
    rinfo.FIELD6               AS REMINFO_FIELD6,
    rinfo.FIELD7               AS REMINFO_FIELD7,
    rinfo.FIELD8               AS REMINFO_FIELD8,
    rinfo.FIELD9               AS REMINFO_FIELD9,
    rinfo.FIELD10              AS REMINFO_FIELD10,
    rinfo.FIELD11              AS REMINFO_FIELD11,
    rinfo.FIELD12              AS REMINFO_FIELD12,
    rinfo.FIELD13              AS REMINFO_FIELD13,
    rinfo.FIELD14              AS REMINFO_FIELD14,
    rinfo.FIELD15              AS REMINFO_FIELD15,
    rinfo.FIELD16              AS REMINFO_FIELD16,
    rinfo.FIELD17              AS REMINFO_FIELD17,
    rinfo.FIELD18              AS REMINFO_FIELD18,
    rinfo.FIELD19              AS REMINFO_FIELD19,
    rinfo.FIELD20              AS REMINFO_FIELD20,

    /* =========================================================
       ================== MTFREMDOC FIELDS (20) ==================
       ========================================================= */
    rdoc.FIELD1                AS REMDOC_FIELD1,
    rdoc.FIELD2                AS REMDOC_FIELD2,
    rdoc.FIELD3                AS REMDOC_FIELD3,
    rdoc.FIELD4                AS REMDOC_FIELD4,
    rdoc.FIELD5                AS REMDOC_FIELD5,
    rdoc.FIELD6                AS REMDOC_FIELD6,
    rdoc.FIELD7                AS REMDOC_FIELD7,
    rdoc.FIELD8                AS REMDOC_FIELD8,
    rdoc.FIELD9                AS REMDOC_FIELD9,
    rdoc.FIELD10               AS REMDOC_FIELD10,
    rdoc.FIELD11               AS REMDOC_FIELD11,
    rdoc.FIELD12               AS REMDOC_FIELD12,
    rdoc.FIELD13               AS REMDOC_FIELD13,
    rdoc.FIELD14               AS REMDOC_FIELD14,
    rdoc.FIELD15               AS REMDOC_FIELD15,
    rdoc.FIELD16               AS REMDOC_FIELD16,
    rdoc.FIELD17               AS REMDOC_FIELD17,
    rdoc.FIELD18               AS REMDOC_FIELD18,
    rdoc.FIELD19               AS REMDOC_FIELD19,
    rdoc.FIELD20               AS REMDOC_FIELD20

FROM dbo.MIF AS mif

LEFT JOIN dbo.MTFISOXML AS mtfiso
    ON mif.MID = mtfiso.MID

LEFT JOIN dbo.MTF1000 AS mtf
    ON mif.MID = mtf.MID
   AND mif.Version = mtf.Version

LEFT JOIN dbo.MTFREMINFO AS rinfo
    ON mif.MID = rinfo.MID
   AND mif.Version = rinfo.Version

LEFT JOIN dbo.MTFREMDOC AS rdoc
    ON mif.MID = rdoc.MID
   AND mif.Version = rdoc.Version;
GO

