SELECT
    DATENAME(MONTH, [DATE]) AS [MONTH],

    SUM(CASE WHEN ADVC_CODE = 'XCC' THEN 1 ELSE 0 END) AS XCC,
    SUM(CASE WHEN ADVC_CODE = 'XCD' THEN 1 ELSE 0 END) AS XCD,
    SUM(CASE WHEN ADVC_CODE = 'FLBC' THEN 1 ELSE 0 END) AS FLBC,
    SUM(CASE WHEN ADVC_CODE = 'FLFXAX' THEN 1 ELSE 0 END) AS FLFXAX,
    SUM(CASE WHEN ADVC_CODE = 'INCSADEM' THEN 1 ELSE 0 END) AS INCSADEM,
    SUM(CASE WHEN ADVC_CODE = 'OTCSADEM' THEN 1 ELSE 0 END) AS OTCSADEM,
    SUM(CASE WHEN ADVC_CODE = 'CSSWFEM' THEN 1 ELSE 0 END) AS CSSWFEM,
    SUM(CASE WHEN ADVC_CODE = 'CSFXFEM' THEN 1 ELSE 0 END) AS CSFXFEM,
    SUM(CASE WHEN ADVC_CODE = 'MCC' THEN 1 ELSE 0 END) AS MCC,
    SUM(CASE WHEN ADVC_CODE = 'MCD' THEN 1 ELSE 0 END) AS MCD,
    SUM(CASE WHEN ADVC_CODE = 'CSSWFLTR' THEN 1 ELSE 0 END) AS CSSWFLTR,
    SUM(CASE WHEN ADVC_CODE = 'CSFXLTR' THEN 1 ELSE 0 END) AS CSFXLTR

FROM ADVICES
WHERE [DATE] >= '20260101'
  AND [DATE] < DATEADD(
        MONTH,
        DATEDIFF(MONTH, 0, GETDATE()) + 1,
        0
      )
  AND ADVC_CODE IN (
      'XCC', 'XCD', 'FLBC', 'FLFXAX',
      'INCSADEM', 'OTCSADEM', 'CSSWFEM', 'CSFXFEM',
      'MCC', 'MCD', 'CSSWFLTR', 'CSFXLTR'
  )

GROUP BY
    MONTH([DATE]),
    DATENAME(MONTH, [DATE])

ORDER BY
    MONTH([DATE]);
